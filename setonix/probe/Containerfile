#####################################################################
# Setonix parallel-IO probe — throwaway diagnostic, not a deliverable.
#
# Answers one question: does a collective MPI-IO write work from inside a
# Singularity container on Setonix, and if not, does binding the host library
# tree so liblustreapi resolves fix it?
#
# Pawsey's Known Issues page says MPI-parallel IO in containers fails with
#   ad_cray/ad_cray_adio_open.c line 520: liblustreapi != NULL
# and that there is no workaround. But that is the same resolution failure
# uw3-scaling-scripts/gadi_container_go.sh fixes on Gadi by binding /half-root.
#
# HDF5 is deliberately absent: the assertion is in Cray MPICH's ROMIO layer,
# which HDF5 merely sits on top of, so mpi4py alone reaches it.
#
#   podman build . --platform linux/amd64 --format docker \
#       -t ghcr.io/jcgraciosa/setonix-ioprobe:latest \
#       -f Containerfile
#####################################################################

# Pawsey's own MPICH base: Ubuntu 24.04 (glibc 2.39, so host Cray MPICH libs
# bind-mount cleanly). 3.4.3, not 4.2.2: Cray MPICH 8.1 is built on MPICH 3.4,
# and anything compiled against 4.x headers references MPI-4 symbols
# (MPI_Buffer_iflush) that the bind-mounted host libmpi lacks — ImportError
# before the test starts. Same ABI (libmpi.so.12), older API surface.
FROM quay.io/pawsey/mpich-base:3.4.3_ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
&&  apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-venv \
        build-essential \
&&  rm -rf /var/lib/apt/lists/*

ENV PYOPT=/opt/venv
RUN python3 -m venv $PYOPT
ENV PATH=$PYOPT/bin:$PATH

# Source build so mpi4py links against this image's MPICH rather than a
# prebuilt wheel's bundled MPI — the whole point is ABI compatibility with
# the host Cray MPICH that Singularity will bind-mount over it.
RUN pip install --no-cache-dir --no-binary=mpi4py "mpi4py>=4,<5"

COPY mpiio_probe.py /opt/mpiio_probe.py

CMD ["python3", "/opt/mpiio_probe.py"]
